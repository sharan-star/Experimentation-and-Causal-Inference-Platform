# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Tool caches (created at runtime by PyMC / ArviZ / matplotlib / numba)
_cache/

# Data & artifacts produced at runtime
data/raw/*
data/processed/*
data/simulated/*
artifacts/*
models/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/simulated/.gitkeep
!artifacts/.gitkeep
!models/.gitkeep

# Environment / secrets
.env
.env.*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Node (frontend has its own .gitignore as well)
node_modules/
frontend/node_modules/
frontend/dist/
